{
  "expo": {
    "name": "Momen Pro",
    "slug": "momen-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "momenpro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waqas.momenpro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Momen Pro requires your location to calculate accurate daily prayer times and solar positions for your area."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.waqas.momenpro",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Momen Pro uses your location while using the app to calculate accurate daily prayer times (Fajr, Dhuhr, Asr, Maghrib, and Isha) based on your coordinates."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#083B32"
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "cda9860a-e3b0-45fa-8965-75fe55e605ff"
      }
    },
    "owner": "waqasd"
  }
}
